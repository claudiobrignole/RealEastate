rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAuthenticated() && userDoc().data.role == 'super_admin';
    }

    function belongsToTenant(tenantId) {
      return isAuthenticated() && userDoc().data.tenantId == tenantId;
    }

    function canAccessTenant(tenantId) {
      return isSuperAdmin() || belongsToTenant(tenantId);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isAuthenticated() && (isSuperAdmin() || request.auth.uid == userId);
    }

    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && (canAccessTenant(tenantId) || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /projects/{projectId} {
      allow read: if resource == null || resource.data.status == 'published'
        || (isAuthenticated() && canAccessTenant(resource.data.tenantId));
      allow create: if isAuthenticated()
        && canAccessTenant(request.resource.data.tenantId);
      allow update, delete: if isAuthenticated()
        && canAccessTenant(resource.data.tenantId);
    }

    match /leads/{leadId} {
      allow read, update: if isAuthenticated()
        && canAccessTenant(resource.data.tenantId);
      allow create: if request.resource.data.keys().hasAll(['tenantId', 'email'])
        && request.resource.data.tenantId is string;
      allow delete: if isAuthenticated()
        && canAccessTenant(resource.data.tenantId);
    }

    match /appointments/{appointmentId} {
      allow read, write: if isAuthenticated()
        && canAccessTenant(
          resource != null ? resource.data.tenantId : request.resource.data.tenantId
        );
    }

    match /webhook_events/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /projects/{projectId}/leads/{leadId} {
      allow read, write: if isAuthenticated()
        && canAccessTenant(
          resource != null ? resource.data.tenantId : request.resource.data.tenantId
        );
    }
  }
}
